<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>cn.hamm</groupId>
    <artifactId>airpower</artifactId>
    <!-- POM 统一版本-->
    <version>20.0.0</version>
    <name>airpower</name>
    <description>AirPower is a fast backend development tool based on SpringBoot3 and JPA.</description>
    <properties>
        <!-- ==================== 项目版本 ==================== -->
        <airpower.version>20.0.0</airpower.version>
        <airpower-core.version>20.0.0</airpower-core.version>

        <!-- ==================== 构建配置 ==================== -->
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- ==================== 主要框架版本 ==================== -->
        <springboot.version>3.5.16</springboot.version>
        <!-- Jackson 必须与 airpower-core 的编译版本一致（core 20.0.0 用的是 2.22.3），
             否则 spring-boot-dependencies 3.5.16 托管的 2.21.4 会把 core 依赖的 Jackson 降级 -->
        <jackson.version>2.22.3</jackson.version>

        <!-- ==================== 第三方库版本 ==================== -->
        <jakarta.servlet.version>6.1.0</jakarta.servlet.version>
        <jetbrains.annotations.version>26.1.0</jetbrains.annotations.version>
        <commons.codec.version>1.23.0</commons.codec.version>
        <lombok.version>1.18.48</lombok.version>
        <reflections.version>0.10.2</reflections.version>
        <aliyun.oss.version>3.18.5</aliyun.oss.version>
        <qcloud.cos.version>5.6.281</qcloud.cos.version>
        <!-- Spring Integration 6.4 起把 Paho 客户端改成了 optional，必须由使用方显式声明 -->
        <paho.version>1.2.5</paho.version>
        <httpclient.version>4.5.14</httpclient.version>
        <commons.logging.version>1.3.4</commons.logging.version>

        <!-- ==================== Java EE/Jakarta EE版本 ==================== -->
        <!-- jakarta.validation-api：BOM 3.5.16 托管 3.0.2，必须顶到 3.1.1 才与 airpower-core 20.0.0
             的编译版本一致（core 也锁的 3.1.1），否则 Bean Validation 的实现类会缺方法 -->
        <jakarta.validation-api.version>3.1.1</jakarta.validation-api.version>
        <!-- jakarta.persistence-api：当前值与 BOM 托管的 3.1.0 相同（也是 Hibernate 6.6.53.Final
             实际使用的版本）。写在这里是刻意锁死 —— 76e43a1b 曾从 3.2.0 回退到 3.1.0 修兼容性问题，
             不写条目的话 BOM 一升级就会被静默抬高回 3.2.0 -->
        <jakarta.persistence-api.version>3.1.0</jakarta.persistence-api.version>

        <!-- ==================== Maven插件版本 ==================== -->
        <maven.source.plugin.version>3.4.0</maven.source.plugin.version>
        <maven.central.publishing.plugin.version>0.12.0</maven.central.publishing.plugin.version>
        <maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
        <maven.gpg.plugin.version>3.2.8</maven.gpg.plugin.version>
        <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
    </properties>
    <packaging>pom</packaging>
    <modules>
        <module>airpower-api</module>
        <module>airpower-exception</module>
        <module>airpower-email</module>
        <module>airpower-cookie</module>
        <module>airpower-mqtt</module>
        <module>airpower-open</module>
        <module>airpower-redis</module>
        <module>airpower-file</module>
    </modules>
    <dependencyManagement>
        <dependencies>
            <!-- ==================== AirPower 内部依赖 ==================== -->
            <dependency>
                <groupId>cn.hamm</groupId>
                <artifactId>airpower-core</artifactId>
                <version>${airpower-core.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hamm</groupId>
                <artifactId>airpower-api</artifactId>
                <version>${airpower.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hamm</groupId>
                <artifactId>airpower-cookie</artifactId>
                <version>${airpower.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hamm</groupId>
                <artifactId>airpower-email</artifactId>
                <version>${airpower.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hamm</groupId>
                <artifactId>airpower-exception</artifactId>
                <version>${airpower.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hamm</groupId>
                <artifactId>airpower-file</artifactId>
                <version>${airpower.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hamm</groupId>
                <artifactId>airpower-mqtt</artifactId>
                <version>${airpower.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hamm</groupId>
                <artifactId>airpower-open</artifactId>
                <version>${airpower.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hamm</groupId>
                <artifactId>airpower-redis</artifactId>
                <version>${airpower.version}</version>
            </dependency>

            <!-- ==================== Spring Boot 依赖 ==================== -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${springboot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-test</artifactId>
                <version>${springboot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-integration</artifactId>
                <version>${springboot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-thymeleaf</artifactId>
                <version>${springboot.version}</version>
            </dependency>

            <!-- ==================== 数据库相关依赖 ==================== -->
            <!-- MySQL 驱动：旧坐标 mysql:mysql-connector-java 已废弃并冻结在 8.0.33（存在已知漏洞），
                 官方迁移到 com.mysql:mysql-connector-j。这里刻意不写 dependencyManagement 条目：
                 Maven 的 dependencyManagement 是「整体覆盖不合并字段」，条目缺 version 就等于
                 没托管版本，反而会让子模块报 version is missing。直接交给 BOM 托管即可。 -->

            <!-- ==================== Java EE/Jakarta EE 依赖 ==================== -->
            <dependency>
                <groupId>jakarta.validation</groupId>
                <artifactId>jakarta.validation-api</artifactId>
                <version>${jakarta.validation-api.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.persistence</groupId>
                <artifactId>jakarta.persistence-api</artifactId>
                <version>${jakarta.persistence-api.version}</version>
            </dependency>

            <!-- ==================== 第三方通用库 ==================== -->
            <!-- lombok 统一锁到与 airpower-core 一致的版本：否则 BOM 的版本号会与本属性打架，
                 同一次构建里不同模块拿到不同 lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <!-- 实际作用域由下面的 <dependencies> 统一为 provided，这里只锁版本 -->
            <dependency>
                <groupId>org.jetbrains</groupId>
                <artifactId>annotations</artifactId>
                <version>${jetbrains.annotations.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>${commons.codec.version}</version>
            </dependency>
            <dependency>
                <groupId>org.reflections</groupId>
                <artifactId>reflections</artifactId>
                <version>${reflections.version}</version>
            </dependency>

            <!-- ==================== 对象存储 SDK ==================== -->
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun.oss.version}</version>
            </dependency>
            <dependency>
                <groupId>com.qcloud</groupId>
                <artifactId>cos_api</artifactId>
                <version>${qcloud.cos.version}</version>
            </dependency>

            <!-- ==================== MQTT 客户端 ==================== -->
            <!-- Spring Boot BOM 不托管 Paho，必须在这里锁版本 -->
            <dependency>
                <groupId>org.eclipse.paho</groupId>
                <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
                <version>${paho.version}</version>
            </dependency>

            <!-- ==================== HTTP 客户端 ==================== -->
            <!-- 阿里云 OSS SDK 锁 httpclient 4.5.13（连带 commons-logging 1.2，2005 年的版本），
                 腾讯云 COS SDK 已经升到 4.5.14。两边不一致时 Maven 按「就近优先」会选中更旧的 4.5.13，
                 所以统一在这里提升到较新版本 -->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${httpclient.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-logging</groupId>
                <artifactId>commons-logging</artifactId>
                <version>${commons.logging.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ==================== 全模块共享的编译期依赖 ==================== -->
    <!-- 各模块的源码普遍 import org.jetbrains.annotations 与 jakarta.servlet，
         过去是吃 airpower-core 的传递依赖。airpower-core 把它们改成 provided 后
         传递链断开，9 个模块同时编译失败。
         在父 pom 统一声明一次：所有模块编译期可见，且不传递给下游 -->
    <dependencies>
        <!-- Lombok：10 个模块里有 7 个在用 @Data / @Slf4j，但只有 3 个模块自己声明过，
             其余全靠 airpower-exception 的传递依赖白嫖。统一提到父 pom 后，
             各模块不必再各自声明版本，注解处理器也不会随传递链流向下游应用 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- @NotNull / @Nullable / @Contract 都是 CLASS 保留期，编译期与 IDE 用，运行期不需要 -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>${jetbrains.annotations.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Servlet API 由容器在运行期提供 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta.servlet.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- ==================== 发布插件 ==================== -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${maven.central.publishing.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>

            <!-- ==================== 源码插件 ==================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven.source.plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ==================== 文档插件 ==================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc.plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <doclint>none</doclint>
                </configuration>
            </plugin>

            <!-- ==================== 编译插件 ==================== -->
            <!-- 父 pom 声明一次即可：build 段的插件会被所有子模块继承并执行 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!-- ==================== 签名插件 ==================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>${maven.gpg.plugin.version}</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                        <configuration>
                            <keyname>5FE4833A28EDA3991EA4F1D239A8BA7AF33610A8</keyname>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <licenses>
        <license>
            <name>The MIT License</name>
            <url>https://raw.githubusercontent.com/AirPowerTeam/AirPower4J/main/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <url>https://github.com/AirPowerTeam/AirPower4J</url>
    <scm>
        <connection>scm:git:git://github.com/AirPowerTeam/AirPower4J.git</connection>
        <developerConnection>scm:git:git://github.com/AirPowerTeam/AirPower4J.git</developerConnection>
        <url>https://github.com/AirPowerTeam/AirPower4J</url>
        <tag>HEAD</tag>
    </scm>
    <developers>
        <developer>
            <id>HammCn</id>
            <name>Hamm</name>
            <email>admin@hamm.cn</email>
            <roles>
                <role>developer</role>
            </roles>
            <timezone>+8</timezone>
            <properties>
                <picUrl>https://avatars.githubusercontent.com/u/16929327</picUrl>
            </properties>
        </developer>
    </developers>
</project>
